# Copy to .env and fill in. This file is read server side only.
# The client secret must never reach the browser: the frontend talks to
# /search on this service, and this service talks to Spotify.

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Comma separated origins allowed to call this API.
ALLOWED_ORIGINS=http://localhost:5173

# Where uploads and rendered output live, and how long they survive.
WORK_DIR=./.work
FILE_TTL_SECONDS=3600

# Uploads larger than this are rejected before hitting disk.
MAX_UPLOAD_MB=60

# Demucs is heavy; this caps how many separations run at once.
MAX_CONCURRENT_JOBS=1
DEMUCS_MODEL=htdemucs
