# Copy to .env.local for local overrides, or set in CI for a deployed build.
# Only VITE_ prefixed values reach the browser, and everything here is public
# by design. Never put a secret in this file: the Spotify client secret lives
# in backend/.env and never leaves the server.

# Where the Phase 2 backend lives. Defaults to http://localhost:8000.
# Leave unset for a static deploy with no backend; the Stems panel will simply
# report "Backend offline" and the rest of the deck works normally.
VITE_API_BASE=http://localhost:8000
